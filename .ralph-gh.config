# .ralph-gh.config — InfraWeaver
# Untracked on purpose: the orchestrator tolerates an untracked config, so it
# never needs a commit and cannot be edited by anyone with push access.

# Typecheck + bundle, then the test suite (#37 landed the Vitest runner).
# `npm run build` == `tsc -b && vite build` (~5s); `test:run` == `vitest run`.
# Build goes first: the broadest signal for the cheapest run.
RALPH_VERIFY_COMMANDS=(
  "npm run build"
  "npm run test:run"
)

RALPH_DOC_FILES=("README.md")
RALPH_BRANCH_PREFIX="ralph"
RALPH_DEFAULT_BASE_BRANCH="main"
RALPH_GATE_FIX_ROUNDS=2
RALPH_SESSION_TIMEOUT=2400

# Empty does NOT disable auto-merge: ralph-gh.sh:385 guards the yolo branch with
# `-n "$RALPH_YOLO_ALLOWLIST"`, so an empty value skips the allowlist check and
# leaves can_merge=1. To make yolo never auto-merge, set '^$' instead.
RALPH_YOLO_ALLOWLIST=''
